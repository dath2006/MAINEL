# ===========================================
# MCMT-ReID Docker Environment Configuration
# ===========================================
# Copy this file to .env and customize as needed

# Application
APP_NAME=MCMT-ReID API
DEBUG=true

# Device Configuration
# Options: 'cuda' for GPU or 'cpu' for CPU-only
# For GPU: Also add docker-compose.gpu.yml to your compose command
DEVICE=cuda

# ===========================================
# ML Models - PeopleNet + Nvidia ReID Pipeline
# ===========================================
# PeopleNet Detection (ONNX model)
PEOPLENET_MODEL_PATH=model_weights/resnet34_peoplenet.onnx
YOLO_CONFIDENCE=0.4

# Nvidia TAO ReID Model (ONNX model)
NVIDIA_REID_ONNX_PATH=model_weights/resnet50_market1501_aicity156.onnx
USE_NVIDIA_REID=true
REID_EMBEDDING_DIM=256

# ReID Thresholds
REID_MATCH_THRESHOLD=0.40
REID_NEW_THRESHOLD=0.50
REID_MERGE_THRESHOLD=0.50

# ===========================================
# Tracking - DeepSORT
# ===========================================
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=3
DEEPSORT_MAX_IOU_DISTANCE=0.7

# ===========================================
# Spatial-Temporal
# ===========================================
ST_WEIGHT=0.5
MAX_TRANSITION_TIME=300.0

# ===========================================
# Gallery & Search
# ===========================================
SEARCH_THRESHOLD=0.5
GALLERY_QUALITY_THRESHOLD=55.0

# ===========================================
# ONNX Runtime
# ===========================================
USE_ONNX=true
ONNX_GPU_MEM_LIMIT=4

# ===========================================
# Note: Database and Redis URLs are set in 
# docker-compose.yml to use container names
# ===========================================
