# Application
APP_NAME=MCMT-ReID API
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:220066@localhost:5432/mcmt_reid

# Redis
REDIS_URL=redis://localhost:6379/0

# OSRM
OSRM_URL=http://localhost:5000

# ML Models
YOLO_MODEL_PATH=model_weights/yolov8n.pt
YOLO_CONFIDENCE=0.55
# OSNET_MODEL_PATH removed - uses auto-download cache
REID_MATCH_THRESHOLD=0.8

# Device
DEVICE=cuda

# Tracking
DEEPSORT_MAX_AGE=10
DEEPSORT_N_INIT=1

# Spatial-Temporal
ST_WEIGHT=0.5
MAX_TRANSITION_TIME=300.0

# SOURCE_FRAME_SKIP=1
# DETECTION_INTERVAL=2
