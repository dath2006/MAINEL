# Application
APP_NAME=MCMT-ReID API
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://mcmt:mcmt_password@localhost:5432/mcmt_reid

# Redis
REDIS_URL=redis://localhost:6379/0

# OSRM
OSRM_URL=http://localhost:5000

# ML Models
YOLO_MODEL_PATH=model_weights/yolov8n.pt
YOLO_CONFIDENCE=0.5
OSNET_MODEL_PATH=model_weights/osnet_x1_0.pth
REID_MATCH_THRESHOLD=0.6

# Device
DEVICE=cuda

# Tracking
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=3

# Spatial-Temporal
ST_WEIGHT=0.5
MAX_TRANSITION_TIME=300.0
