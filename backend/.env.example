# Application
APP_NAME=MCMT-ReID API
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:220066@localhost:5432/mcmt_reid

# Redis
REDIS_URL=redis://localhost:6379/0

# OSRM
OSRM_URL=http://localhost:5000

# ML Models
YOLO_MODEL_PATH=model_weights/yolov8s.pt
YOLO_CONFIDENCE=0.5
# OSNET_MODEL_PATH removed - uses auto-download cache

# =============================================
# ReID Matching Thresholds
# =============================================
# Threshold for matching to existing identity (lower = more lenient cross-camera matching)
REID_MATCH_THRESHOLD=0.40

# Threshold for confirming it's definitely a new person (higher = less false new IDs)
REID_NEW_THRESHOLD=0.50

# Search & Gallery Thresholds
SEARCH_THRESHOLD=0.5
GALLERY_QUALITY_THRESHOLD=55.0

# Threshold for merging fragmented IDs in search results (lower = more aggressive merging)
REID_MERGE_THRESHOLD=0.6


# Device
DEVICE=cuda

# Tracking
DEEPSORT_MAX_AGE=10
DEEPSORT_N_INIT=1

# Spatial-Temporal
ST_WEIGHT=0.5
MAX_TRANSITION_TIME=300.0

# # =============================================
# # ReID Two-Threshold System
# # =============================================
# # High-confidence threshold for matching (above = confirmed same person)
# REID_CONFIRM_THRESHOLD=0.60

# # Low-confidence threshold (below = definitely new person)
# REID_NEW_IDENTITY_THRESHOLD=0.40

# # Threshold for getting initial gallery candidates
# REID_CANDIDATE_THRESHOLD=0.30

# # =============================================
# # Gallery Update Thresholds
# # =============================================
# # Similarity required to blend (merge) embeddings in gallery
# GALLERY_MERGE_THRESHOLD=0.85

# # Quality improvement required to replace exemplar embedding
# GALLERY_QUALITY_DELTA=0.10

# # Maximum number of identities to track in gallery
# GALLERY_MAX_SIZE=1000

# # =============================================
# # K-Reciprocal Reranking Parameters
# # =============================================
# RERANK_K1=20
# RERANK_K2=6
# RERANK_LAMBDA=0.3

# # =============================================
# # Face Detection & Fusion Thresholds
# # =============================================
# # InsightFace detection confidence threshold
# FACE_DET_THRESHOLD=0.60

# # Below this quality, face is ignored in fusion (body only)
# FACE_QUALITY_LOW_TIER=0.4

# # Above this quality, face is heavily trusted in fusion
# FACE_QUALITY_HIGH_TIER=0.7

# # Face weight when quality is above high tier (body_weight = 1 - face_weight)
# FACE_HIGH_TIER_WEIGHT=0.7

# # Face weight when quality is between low and high tier
# FACE_MEDIUM_TIER_WEIGHT=0.2

# # =============================================
# # Spatial-Temporal Parameters
# # =============================================
# # Pedestrian walking speeds (m/s)
# ST_MIN_SPEED=0.5
# ST_AVG_SPEED=1.4
# ST_MAX_SPEED=3.0

# # Parzen window bandwidth for transition time estimation (seconds)
# ST_BANDWIDTH=5.0

# # Minimum ST probability for plausible camera transition
# ST_PLAUSIBILITY_THRESHOLD=0.1